# Este arquivo documentará as variáveis quando cada módulo for implementado.
# Não adicione credenciais reais ao repositório.

APP_ENV=development
# Opcionais: duração da sessão em dias (padrão 14) e cookie só por HTTPS (padrão: true em produção).
# SESSION_TTL_DAYS=14
# SESSION_COOKIE_SECURE=false
DATABASE_URL=postgresql+psycopg://USER:SENHA@localhost:5432/gerencia_db
# Opcional: conexão do proprietário das tabelas, usada somente pelo Alembic.
# Deve apontar para o MESMO banco de DATABASE_URL. Nunca use no frontend.
# Sem ela, as migrações usam DATABASE_URL e exigem permissões de proprietário.
# MIGRATION_DATABASE_URL=postgresql+psycopg://OWNER:SENHA@localhost:5432/gerencia_db
OPENAI_API_KEY=
OPENAI_MODEL=

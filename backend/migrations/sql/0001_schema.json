      "error_message",
      "id",
      "raw_data",
      "source_row",
      "upload_id",
      "user_id"
    ],
    "constraints": [
      "rejected_rows_error_code_not_empty",
      "rejected_rows_error_message_not_empty",
      "rejected_rows_one_error_per_code_uq",
      "rejected_rows_raw_is_object",
      "rejected_rows_source_row_positive",

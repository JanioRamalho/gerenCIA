    "constraints": [
      "transactions_bronze_row_fk",
      "transactions_category_source_valid",
      "transactions_description_not_empty",
      "transactions_installments_valid",
      "transactions_source_row_positive",
      "transactions_type_valid",
      "transactions_upload_user_fk"
    ],
    "indexes": [
      "transactions_bronze_row_uq",
      "transactions_upload_idx",
      "transactions_user_category_date_idx",
      "transactions_user_date_idx",
      "transactions_user_merchant_idx"
